# Производный файл не хранится в репозитории: регенерация обнуляет его молча
# (правило 125). Байт-код Python — ровно такой файл, и он уже успел приехать
# изменением, которого никто не делал: любое окно, импортирующее скрипт
# каталога, переписывает .pyc (задача #70).
__pycache__/
*.pyc

# Значки версии собираются прогоном и живут на ветке `badges`, а не в `main`:
# версия — свойство истории и тегов, а не дерева, и в общей ветке она устаревала
# бы на каждом слиянии (см. .github/workflows/badges.yml и VERSIONING.md).
.github/badges/release.json
.github/badges/version.json

# Данные замера покрытия. Число из них ставит значок, сами они производные
# и в дереве не хранятся (правило 125).
.coverage
coverage.xml
.pytest_cache/

# Значки живут на отдельной ветке `badges`, а не в общей. Здесь они появляются
# только как побочный продукт сборки — их пересобирает badges.yml и кладёт
# туда. Держать их в main значило бы требовать пересборки значка от каждого
# изменения: конфликт на каждом слиянии и красная общая ветка после каждого.
.github/badges/*.json
# Картинки витрины — то же самое и по той же причине (правило 160). Витрина
# читает их С ВЕТКИ `badges`, а копия в дереве пересобиралась ночным прогоном:
# за одну смену это дало четыре коммита в общую ветку с файлами, которых никто
# не читает. Игнор здесь обязателен и недостаточен: при слиянии его не
# спрашивают, поэтому возврат ловит scripts/check_showcase.py.
.github/badges/*.svg

# Сводка «где действует» — производное с ОДНИМ писателем, и место ему там же,
# где картинке: на ветке `badges` (правило 160). В общей ветке она давала
# конфликт на каждом изменении, которое трогало ответ каталога о себе — шесть
# за одну смену 3 сентября, и ни один не был поломкой. Половинчатая починка
# (объявить одного писателя, оставив файл в дереве) убрала рутинные конфликты и
# оставила предмет: писателей снова стало двое, как только правило добавляли
# вместе с ответом о нём.
#
# Витрина и потребители читают сводку С ВЕТКИ `badges`, как и картинку.
# Игнор здесь обязателен и недостаточен: при слиянии его не спрашивают,
# поэтому возврат файла в дерево ловит scripts/check_derived.py.
export/where.json
export/where.md
